# 复制本文件为 .env.local，填入真实信息后重启 npm run dev
# 部署到 Vercel 时：在 Project → Settings → Environment Variables 填同样的键

# —— Supabase（留言存储）——
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_key

# —— 网易邮箱 SMTP（留言邮件通知，可选）——
# 授权码不是登录密码：163邮箱 → 设置 → POP3/SMTP/IMAP → 开启 SMTP → 生成授权码
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your@163.com
SMTP_PASS=your_smtp_auth_code
NOTIFY_EMAIL=your@163.com
